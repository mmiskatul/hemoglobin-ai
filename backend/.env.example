PORT=8001
HOST=0.0.0.0

# Standalone AI Subsystem Microservice (see ai-system/.env.example)
AI_SYSTEM_URL=http://localhost:8002

# JWT Security Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Cloudinary Image Upload Configuration
CLOUDINARY_CLOUD_NAME=smartbloodhub
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=smart_blood_hub_preset

# MongoDB Atlas Cloud Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_blood_hub?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_blood_hub

# SMTP Email Verification & Dispatch Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@smartbloodhub.org

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone Vector RAG Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=hemoglobin-knowledge
PINECONE_INDEX_HOST=https://hemoglobin-knowledge-7ck0g8s.svc.aped-4627-b74a.pinecone.io
PINECONE_NAMESPACE=hemoglobin-knowledge
